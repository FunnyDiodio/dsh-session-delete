{
  "name": "dsh-session-delete",
  "version": "1.1.0",
  "description": "Adds a Delete Session row to the sidebar session '...' menu: a confirm dialog with a force option, then the session log, projection cache and registry bookkeeping are permanently removed. Workspace files created in the session are kept.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/dsh-session-delete.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "session",
    "delete"
  ],
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
