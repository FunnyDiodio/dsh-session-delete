{
  "name": "@funny_diodio/dsh-session-delete",
  "version": "1.2.5",
  "description": "Adds a Delete Session row to the sidebar session '...' menu: a confirm dialog with a one-click Force delete that releases the session from memory, stops its work, and removes the log, projection cache and registry bookkeeping with no ghost rows left. Workspace files created in the session are kept.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FunnyDiodio/dsh-session-delete.git"
  },
  "homepage": "https://github.com/FunnyDiodio/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/FunnyDiodio/dsh-session-delete/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "session",
    "delete"
  ],
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
